# Copy to .env and fill in credentials you obtain manually.
# Never commit .env or expose these keys to the iOS app.

# Google Maps Platform — enable Routes API
# https://developers.google.com/maps/documentation/routes
GOOGLE_MAPS_API_KEY=

# RailRadar — https://railradar.in/docs (key prefix rg_)
RAILRADAR_API_KEY=

# Optional overrides
OSRM_BASE_URL=https://routing.openstreetmap.de
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
RAILRADAR_BASE_URL=https://api.railradar.in
GTFS_DATA_DIR=data/gtfs

PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=2
CACHE_GEOCODE_TTL_SECONDS=86400
CACHE_ROUTE_TTL_SECONDS=300

MAX_TRANSFER_WALK_METERS=800
MAX_LAST_MILE_WALK_METERS=1500
MAX_WALK_ONLY_METERS=2000
MAX_TRANSFERS=3
MAX_ROUTE_DURATION_MINUTES=240

# Optional experimental ML assist (deterministic ranking always works)
ENABLE_ML_ASSIST=true
REQUIRE_GOOGLE_KEY=false
